# OntoForge local development defaults
# Copy to .env before first run and change the password if needed.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8765

# PDF Extraction with Marker
# Set to "marker" to use Marker PDF extractor instead of the default
# ONTOFORGE_PDF_EXTRACTOR=marker
# Path to marker_single executable (adjust path to your installation)
# ONTOFORGE_MARKER_COMMAND=/path/to/.venvs/marker/bin/marker_single

# Optional Marker flags (uncomment to enable)
# ONTOFORGE_MARKER_FORCE_OCR=true
# ONTOFORGE_MARKER_USE_LLM=true
# ONTOFORGE_MARKER_REDO_INLINE_MATH=true
# ONTOFORGE_MARKER_PAGE_RANGE="0-4"

# LLM Service Configuration
# Required for AI-powered paper ingestion, subdomain classification, and domain pack bootstrapping
# Without LLM enabled, the system falls back to basic rule-based classification

# Enable LLM service (set to true to activate)
# ONTOFORGE_LLM_ENABLED=true
# ONTOFORGE_LLM_PROVIDER=openai_compatible

# === OpenAI Configuration (GPT-4, etc.) ===
# Uncomment and configure to use OpenAI models:
# ONTOFORGE_LLM_MODEL=gpt-4o
# ONTOFORGE_LLM_API_BASE_URL=https://api.openai.com/v1
# ONTOFORGE_LLM_API_KEY=sk-your-openai-api-key-here

# === Anthropic Claude Configuration ===
# Uncomment and configure to use Claude models:
# ONTOFORGE_LLM_MODEL=claude-3-5-sonnet-20241022
# ONTOFORGE_LLM_API_BASE_URL=https://api.anthropic.com/v1
# ONTOFORGE_LLM_API_KEY=your-anthropic-api-key-here

# === Local Ollama Configuration ===
# Uncomment and configure to use local Ollama models:
# ONTOFORGE_LLM_PROVIDER=ollama
# ONTOFORGE_LLM_MODEL=llama3.2:3b
# ONTOFORGE_LLM_API_BASE_URL=http://localhost:11434

# === Custom OpenAI-Compatible Provider ===
# For self-hosted models, Azure OpenAI, or other compatible endpoints:
# ONTOFORGE_LLM_PROVIDER=openai_compatible
# ONTOFORGE_LLM_MODEL=your-model-name
# ONTOFORGE_LLM_API_BASE_URL=https://your-custom-endpoint.com/v1
# ONTOFORGE_LLM_API_KEY=your-custom-api-key

# === Advanced LLM Settings ===
# ONTOFORGE_LLM_TEMPERATURE=0.0
# ONTOFORGE_LLM_TIMEOUT_SECONDS=60
# ONTOFORGE_LLM_MAX_OUTPUT_TOKENS=4096